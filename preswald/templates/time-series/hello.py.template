from preswald import connect, get_df, text, query,table, slider, plotly, sidebar, Workflow
import plotly.express as px
    
connect()  
workflow = Workflow()
df = get_df('sample_csv')


## all movies

text("# Language wise analysis of movies on IMDb")
text("## Visualization of movies according to language")
text("Throughout the database of movies available on IMDb, ")
## number of movies per language
number_of_movies = slider(
        label="Total number of movies",
        min_val=10,
        max_val=80,
        step=5,
        default=40
    )
freq_query = f"""
   SELECT original_language, COUNT(*) AS frequency
FROM (
    SELECT *
    FROM sample_csv
    ORDER BY vote_average DESC
    LIMIT {number_of_movies}
) AS top_number
GROUP BY original_language
ORDER BY frequency DESC;
"""

query_freq = query(freq_query,"sample_csv")
fig1 = px.line(query_freq, x="original_language", y="frequency", title="Number of Movies for every language")


plotly(fig1)

